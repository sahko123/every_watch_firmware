/*
 * MCUboot DTS overlay for Every Watch.
 *
 * Strip sensor/peripheral nodes that would pull in Kconfig symbols
 * MCUboot doesn't have (RTC_ALARM, SPI sensors, etc.).
 */

/ {
	aliases {
		/delete-property/ rtc0;
		/delete-property/ batt0;
		/delete-property/ light0;

		/* Required by CONFIG_BOOT_USB_DFU_GPIO -- io.c hard-#errors without
		 * it. MCUboot samples this pin before booting the app: held = stay
		 * in USB DFU indefinitely, released = boot normally with no delay. */
		mcuboot-button0 = &button_left;
	};
};

&i2c0 {
	/delete-node/ frtc8900@32;
	/delete-node/ bmi270@68;
	/delete-node/ bh1750@23;
	/delete-node/ bq27441@55;
};

/* USB stays enabled — MCUboot uses it for USB DFU mode */
