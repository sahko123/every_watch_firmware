--- a/subsys/usb/device/class/dfu/usb_dfu.c
+++ b/subsys/usb/device/class/dfu/usb_dfu.c
@@ -53,6 +53,15 @@
 #include <usb_descriptor.h>
 #include <usb_work_q.h>
 
+/* every_watch local patch — see wait_for_usb_dfu() below. Only meaningful
+ * (and only resolves — this header lives outside this file's normal
