+#ifdef CONFIG_BOOT_WATCHDOG_FEED
+#include <mcuboot_config/mcuboot_config.h>
+#endif
+
 #include <zephyr/logging/log.h>
 LOG_MODULE_REGISTER(usb_dfu, CONFIG_USB_DEVICE_LOG_LEVEL);
 
@@ -372,10 +381,24 @@ static void dfu_reset_counters(void)
 	}
 }
 
+#ifdef CONFIG_BOOT_WATCHDOG_FEED
+/* every_watch local patch — bumped on every download block actually written
+ * to flash, so wait_for_usb_dfu()'s watchdog gating below has a signal that
+ * genuinely tracks download progress. dfu_data.block_nr is NOT usable for
+ * this: it is only incremented on the DFU_UPLOAD path (device->host), which
+ * this build does not even enable (CONFIG_USB_DFU_ENABLE_UPLOAD=n), so it
+ * is permanently zero during a normal firmware download. */
+static uint32_t dfu_progress_ctr;
+#endif
+
 static void dfu_flash_write(uint8_t *data, size_t len)
 {
 	bool flush = false;
 
+#ifdef CONFIG_BOOT_WATCHDOG_FEED
+	dfu_progress_ctr++;
+#endif
+
 	if (!len) {
 		/* Download completed */
 		flush = true;
@@ -941,22 +964,111 @@ static bool is_dfu_started(void)
  *
  * @return  N/A
  */
+#ifdef CONFIG_BOOT_WATCHDOG_FEED
+/* every_watch local patch — MCUBOOT_WATCHDOG_SETUP() (mcuboot_config.h)
+ * arms a short (30s) hardware timeout meant to catch a genuine hang, but
+ * this function never fed it upstream: not while waiting for a human to
+ * start a transfer, not while one is in progress (the k_poll below can
+ * block for the whole rest of a large transfer). Feeding unconditionally
+ * on every loop iteration would defeat the point — a confused-but-still-
+ * scheduling DFU state would keep this loop running forever and never
+ * starve the watchdog.
+ *
+ * So: feed freely while genuinely idle, and only apply a starvation clock
+ * once a transfer is actually underway.
+ *
+ *   idle (appIDLE/dfuIDLE) -> always feed. This is the "held the button,
+ *       now go find the right USB cable / sort out Zadig drivers" state,
+ *       and it is deliberately allowed to last indefinitely (see
+ *       child_image/mcuboot.conf, and commit d4b4585 which replaced a 5s
+ *       DFU window with a persistent hold precisely so there is no
+ *       timeout to race here). Putting any ceiling on this state would
+ *       quietly reintroduce exactly what that change removed.
+ *
+ *   anything else (dfuDNBUSY/dfuDNLOAD_IDLE mid-transfer, dfuERROR, ...)
+ *       -> feed only while dfu_progress_ctr has moved within the last
+ *       DFU_WDT_PROGRESS_TIMEOUT_MS. Once it hasn't, stop feeding on
+ *       purpose so the 30s hardware timeout catches up and resets —
+ *       turning "wedged mid-transfer, and with no VBUS sense on this
+ *       board unplugging the cable doesn't reset the chip either, so
+ *       only SWD gets you out" into "self-heals in a few minutes".
+ *
+ * The progress window is deliberately generous relative to the hardware
+ * timeout: it only has to be longer than the worst-case gap between two
+ * consecutive flash writes of a healthy transfer, and being wrong in the
+ * tight direction resets a device mid-write, which is far worse than
+ * taking a few extra minutes to recover a wedged one.
+ */
+#define DFU_WDT_PROGRESS_TIMEOUT_MS (5 * 60 * 1000)
+
+static void dfu_watchdog_tick(int64_t *last_progress, uint32_t *last_ctr)
+{
+	if (dfu_progress_ctr != *last_ctr) {
+		*last_ctr = dfu_progress_ctr;
+		*last_progress = k_uptime_get();
+	}
+
+	/* Idle means "waiting on a human", not "hung" — never let the
+	 * starvation clock run here. Also re-arm it, so a transfer that
+	 * starts after a long idle wait gets its full window. */
+	if (dfu_data.state == appIDLE || dfu_data.state == dfuIDLE) {
+		*last_progress = k_uptime_get();
+		MCUBOOT_WATCHDOG_FEED();
+		return;
+	}
+
+	if (k_uptime_get() - *last_progress < DFU_WDT_PROGRESS_TIMEOUT_MS) {
+		MCUBOOT_WATCHDOG_FEED();
+	}
+}
+#endif /* CONFIG_BOOT_WATCHDOG_FEED */
+
 void wait_for_usb_dfu(k_timeout_t delay)
 {
 	k_timepoint_t end = sys_timepoint_calc(delay);
+#ifdef CONFIG_BOOT_WATCHDOG_FEED
+	int64_t last_progress = k_uptime_get();
+	uint32_t last_ctr = dfu_progress_ctr;
+#endif
 
 	/* Wait for a prescribed duration of time. If DFU hasn't started within
 	 * that time, stop waiting and proceed further.
 	 */
 	while (!sys_timepoint_expired(end)) {
+#ifdef CONFIG_BOOT_WATCHDOG_FEED
+		dfu_watchdog_tick(&last_progress, &last_ctr);
+#endif
 		if (is_dfu_started()) {
 			k_poll_event_init(&dfu_event, K_POLL_TYPE_SIGNAL,
 				K_POLL_MODE_NOTIFY_ONLY, &dfu_signal);
 
 			/* Wait till DFU is complete */
+#ifdef CONFIG_BOOT_WATCHDOG_FEED
+			/* Bounded poll instead of one unbounded K_FOREVER wait,
+			 * specifically so there's a recurring point to feed
+			 * from while a transfer is actively in progress. */
+			while (true) {
+				int rc;
+
+				dfu_watchdog_tick(&last_progress, &last_ctr);
+				rc = k_poll(&dfu_event, 1,
+					    K_MSEC(INTERMITTENT_CHECK_DELAY));
+				if (rc == 0) {
+					break;
+				}
+				if (rc != -EAGAIN) {
+					/* -EAGAIN is the expected per-iteration
+					 * timeout; anything else is a real error,
+					 * and spinning on it would busy-loop. */
+					LOG_DBG("USB DFU Error");
+					break;
+				}
+			}
+#else
 			if (k_poll(&dfu_event, 1, K_FOREVER) != 0) {
 				LOG_DBG("USB DFU Error");
 			}
+#endif
 
 			LOG_INF("USB DFU Completed");
 			break;
