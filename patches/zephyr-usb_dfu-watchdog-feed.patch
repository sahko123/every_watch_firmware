diff --git a/subsys/usb/device/class/dfu/usb_dfu.c b/subsys/usb/device/class/dfu/usb_dfu.c
index db1706de1d6..7c91308b297 100644
--- a/subsys/usb/device/class/dfu/usb_dfu.c
+++ b/subsys/usb/device/class/dfu/usb_dfu.c
@@ -53,6 +53,15 @@
 #include <usb_descriptor.h>
 #include <usb_work_q.h>
 
+/* every_watch local patch — see wait_for_usb_dfu() below. Only meaningful
+ * (and only resolves — this header lives outside this file's normal
+ * include path) when this file is compiled as part of an MCUboot image
+ * with CONFIG_BOOT_WATCHDOG_FEED set; guarded so a plain Zephyr app using
+ * this same DFU class code is unaffected. */
+#ifdef CONFIG_BOOT_WATCHDOG_FEED
+#include <mcuboot_config/mcuboot_config.h>
+#endif
+
 #include <zephyr/logging/log.h>
 LOG_MODULE_REGISTER(usb_dfu, CONFIG_USB_DEVICE_LOG_LEVEL);
 
@@ -941,22 +950,77 @@ static bool is_dfu_started(void)
  *
  * @return  N/A
  */
+#ifdef CONFIG_BOOT_WATCHDOG_FEED
+/* every_watch local patch — MCUBOOT_WATCHDOG_SETUP() (mcuboot_config.h)
+ * arms a short (30s) hardware timeout meant to catch a genuine hang, but
+ * this function itself never fed it upstream: not while waiting for a
+ * human to start a transfer, not while one is in progress (the k_poll
+ * below can block for the whole rest of a large transfer). Feeding
+ * unconditionally on every loop iteration would defeat the point — a
+ * confused-but-still-scheduling DFU state would keep this loop running
+ * forever and never starve the watchdog. Feeding is instead gated on
+ * genuine DFU progress (dfu_data.block_nr incrementing): as long as
+ * something happened within the last DFU_WDT_PROGRESS_TIMEOUT_MS, keep
+ * feeding; once nothing has for that long, stop on purpose, so the short
+ * hardware timeout catches up and forces a reset shortly after — turning
+ * "wedged indefinitely, no VBUS sense means unplugging doesn't reset the
+ * chip, only SWD gets you out" into "self-heals within a few minutes".
+ *
+ * The two timeouts are deliberately different orders of magnitude: this
+ * one has to be generous enough that a human taking their time to plug in
+ * a cable, or a slow/large transfer that's still genuinely progressing,
+ * is never mistaken for "stuck".
+ */
+#define DFU_WDT_PROGRESS_TIMEOUT_MS (5 * 60 * 1000)
+
+static void dfu_watchdog_tick(int64_t *last_progress, uint16_t *last_block)
+{
+	if (dfu_data.block_nr != *last_block) {
+		*last_block = dfu_data.block_nr;
+		*last_progress = k_uptime_get();
+	}
+	if (k_uptime_get() - *last_progress < DFU_WDT_PROGRESS_TIMEOUT_MS) {
+		MCUBOOT_WATCHDOG_FEED();
+	}
+}
+#endif /* CONFIG_BOOT_WATCHDOG_FEED */
+
 void wait_for_usb_dfu(k_timeout_t delay)
 {
 	k_timepoint_t end = sys_timepoint_calc(delay);
+#ifdef CONFIG_BOOT_WATCHDOG_FEED
+	int64_t last_progress = k_uptime_get();
+	uint16_t last_block = dfu_data.block_nr;
+#endif
 
 	/* Wait for a prescribed duration of time. If DFU hasn't started within
 	 * that time, stop waiting and proceed further.
 	 */
 	while (!sys_timepoint_expired(end)) {
+#ifdef CONFIG_BOOT_WATCHDOG_FEED
+		dfu_watchdog_tick(&last_progress, &last_block);
+#endif
 		if (is_dfu_started()) {
 			k_poll_event_init(&dfu_event, K_POLL_TYPE_SIGNAL,
 				K_POLL_MODE_NOTIFY_ONLY, &dfu_signal);
 
 			/* Wait till DFU is complete */
+#ifdef CONFIG_BOOT_WATCHDOG_FEED
+			/* Bounded poll instead of one unbounded K_FOREVER wait,
+			 * specifically so there's a recurring point to feed
+			 * from while a transfer is actively in progress. */
+			while (true) {
+				dfu_watchdog_tick(&last_progress, &last_block);
+				if (k_poll(&dfu_event, 1,
+					   K_MSEC(INTERMITTENT_CHECK_DELAY)) == 0) {
+					break;
+				}
+			}
+#else
 			if (k_poll(&dfu_event, 1, K_FOREVER) != 0) {
 				LOG_DBG("USB DFU Error");
 			}
+#endif
 
 			LOG_INF("USB DFU Completed");
 			break;
