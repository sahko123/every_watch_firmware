/dts-v1/;
#include <nordic/nrf52833_qdaa.dtsi>
#include <dt-bindings/gpio/gpio.h>
#include <dt-bindings/i2c/i2c.h>
#include "every_watch_nrf52833-pinctrl.dtsi"

/ {
	model = "Every Watch";
	compatible = "everywatch,every-watch-nrf52833";

	chosen {
		zephyr,sram           = &sram0;
		zephyr,flash          = &flash0;
		zephyr,code-partition = &slot0_partition;
		/* DFU: MCUboot USB DFU GPIO mode — hold the left button through a
		 * power-on (or through the in-app 3 s hold reboot) and the
		 * bootloader stays in DFU until flashed:
		 *   dfu-util -d 2fe3:0100 -a 0 -D build/zephyr/app_update.bin */
	};

	/* ── Buttons ─────────────────────────────────────────────────────── */
	buttons {
		compatible = "gpio-keys";

		button_left: button_left {
			gpios = <&gpio0 17 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>;
			label = "Left button";
		};

		button_right: button_right {
			gpios = <&gpio0 15 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>;
			label = "Right button";
		};
	};

	/* ── Charge / battery GPIOs (input only at this stage) ───────────── */
	gpio_inputs {
		compatible = "gpio-keys";

		/* SGM41524 charge indicator — active low */
		chg_indicator: chg_indicator {
			gpios = <&gpio0 5 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>;
			label = "Charge indicator";
		};

		/* BQ27441 GPOUT / battery monitor interrupt — open-drain output,
		 * pull-up required (no PCB resistor assumed). */
		batt_gpout: batt_gpout {
			gpios = <&gpio1 9 (GPIO_ACTIVE_HIGH | GPIO_PULL_UP)>;
			label = "Battery GPOUT";
		};
	};

	aliases {
		btn-left  = &button_left;
		btn-right = &button_right;
		rtc0      = &frtc8900;
		batt0     = &bq27441;
		light0    = &bh1750;
		/* MCUboot starts this watchdog (see child_image/mcuboot.conf)
		 * and the app must feed it or the board resets every ~30s —
		 * see src/watchdog/watchdog.c. Shared here (not just in
		 * child_image/mcuboot.overlay) so the app build resolves
		 * DT_ALIAS(watchdog0) too. */
		watchdog0 = &wdt0;
	};
};

/* ── Flash partitions ────────────────────────────────────────────────── */
/* nRF52833: 512 KB flash (0x00000000 – 0x0007FFFF)
 *
 *   MCUboot  :  48 KB  0x00000000 – 0x0000BFFF  (USB DFU GPIO mode, 97% full)
 *   Slot 0   : 448 KB  0x0000C000 – 0x0007BFFF  (single image slot, no slot 1)
 *   Identity :   8 KB  0x0007C000 – 0x0007DFFF  (encounter hashes, enc_count — NVS)
 *   Settings :   8 KB  0x0007E000 – 0x0007FFFF  (Zephyr Settings / BT bond keys)
 *
 * Single-slot: hold the left button through power-on (or through the in-app
 * 3 s hold reboot) -> MCUboot stays in USB DFU until flashed ->
 * dfu-util -d 2fe3:0100 -a 0 -D build/zephyr/app_update.bin
 * Matches pm_static.yml. */
&flash0 {
	partitions {
		compatible = "fixed-partitions";
		#address-cells = <1>;
		#size-cells = <1>;

		boot_partition: partition@0 {
			label = "mcuboot";
			reg = <0x00000000 0xC000>;
			read-only;
		};

		slot0_partition: partition@C000 {
			label = "image-0";
			reg = <0x0000C000 0x70000>;
		};

		identity_partition: partition@7C000 {
			label = "identity_partition";
			reg = <0x0007C000 0x2000>;
		};

		/* Zephyr Settings backend (BT bond keys); matches pm_static.yml nvs_storage */
		storage_partition: partition@7E000 {
			label = "storage";
			reg = <0x0007E000 0x2000>;
		};
	};
};

/* ── I2C0 — all on-board sensors ─────────────────────────────────────── */
&i2c0 {
	compatible = "nordic,nrf-twim";
	status = "okay";
	pinctrl-0 = <&i2c0_default>;
	pinctrl-1 = <&i2c0_sleep>;
	pinctrl-names = "default", "sleep";
	/* 100 kHz, not 400 kHz: this PCB revision has no external pull-up
	 * resistors, so the bus relies on the nRF's internal ~13k pull-ups and
	 * their ~1 us rise time. See the workaround note in the pinctrl file.
	 * Restore I2C_BITRATE_FAST once 2.2k-4.7k resistors are fitted. */
	clock-frequency = <I2C_BITRATE_STANDARD>;

	/* The BMI260 driver uploads its 8 KB feature-engine config blob in
	 * 256-byte bursts, and the nRF TWIM driver has to prepend the register
	 * address to each one. It merges them through an internal concatenation
	 * buffer that defaults to 16 bytes, so every chunk was rejected with
	 * "internal driver buffer ... insufficient (1 + 256 > 16)" and nothing
	 * ever reached the sensor — leaving it stuck short of INIT_OK. 257 is
	 * the true minimum; 264 rounds up for headroom. Costs this much RAM
	 * permanently, which is why it is not simply set large. */
	zephyr,concat-buf-size = <264>;

	frtc8900: frtc8900@32 {
		compatible = "nyfea,frtc8900";
		reg = <0x32>;
		/* /INT: open-drain, active low — GPIO pull-up required */
		int-gpios = <&gpio0 0 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>;
	};

	bmi260: bmi260@68 {
		compatible = "bosch,bmi260";
		reg = <0x68>;
		irq-gpios = <&gpio0 30 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>,
		            <&gpio0 31 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>;
	};

	bh1750: bh1750@23 {
		compatible = "rohm,bh1750";
		reg = <0x23>;

		/*
		 * High-resolution mode 2: 0.5 lx per count instead of 1 lx.
		 *
		 * Free. The driver picks the same 180 ms integration time for
		 * modes 1 and 2 (bh1750_get_wait_time_from_dts_device) and
		 * halves the result in the conversion, so this is twice the
		 * resolution at no cost in time or power.
		 *
		 * It matters at the dark end specifically. The lux -> brightness
		 * curve in light.c climbs 24 -> 60 between 5 and 10 lx, i.e.
		 * 7.2 brightness units per lux — fifteen times steeper than
		 * anywhere above 50 lx. At 1 lx resolution each sensor count
		 * moves the display by 7 units; at 0.5 lx it moves 3.6. That is
		 * the difference between visible stepping in a dim room and not.
		 */
		resolution = <2>;

		/*
		 * Measurement time register, default. Raising it buys sensitivity
		 * at the cost of proportionally longer integration and a lower
		 * saturation ceiling — 138 would double both the sensitivity and
		 * the 180 ms conversion, and halve the ~54 klx maximum. Stated
		 * explicitly so the choice is visible rather than inherited.
		 */
		mtreg = <69>;
	};

	bq27441: bq27441@55 {
		compatible = "ti,bq274xx";
		reg = <0x55>;
		/* design-capacity MUST match the cell actually fitted, in mAh. The
		 * BQ27441 scales every state-of-charge figure by it, so a wrong
		 * value does not just skew the percentage — it is what made the
		 * gauge report 5-10% on a healthy 3.65 V battery during bring-up
		 * and left the low-battery indicator permanently asserted.
		 *
		 * Currently 400 mAh: the cell to hand. Update this one number when
		 * a larger cell goes in — nothing else in the firmware needs to
		 * change, and the low-battery warning triggers on voltage so it
		 * stays correct either way.
		 *
		 * The driver writes this to the gauge at init, but the BQ27441
		 * still refines its own model over a full charge/discharge cycle,
		 * so expect the percentage to be approximate until then. */
		design-capacity = <400>;
		design-voltage = <3700>;   /* mV nominal */
		/* Charge-termination current. Convention is C/10, so 40 mA at
		 * 400 mAh. Ideally match whatever the SGM41524 actually terminates
		 * at rather than the convention. */
		taper-current = <40>;      /* mA */
		terminate-voltage = <3000>; /* mV cutoff */
	};
};

/* ── SPI peripherals — unused ───────────────────────────────────────── */
/* The LED matrix is driven by PWM + EasyDMA (see src/led_matrix/led_matrix.c),
 * not SPI. WS2812B is self-clocked and needs no clock line; SPIM would have
 * required an SCK pin assigned to a stub just to clock its shift register.
 * All SPI instances are therefore disabled so they do not claim the pins. */
&spi0 {
	status = "disabled";
};

&spi1 {
	status = "disabled";
};

&spi2 {
	status = "disabled";
};

&spi3 {
	status = "disabled";
};

/* ── GPIO ports ──────────────────────────────────────────────────────── */
&gpio0 {
	status = "okay";
};

&gpio1 {
	status = "okay";
};

&gpiote {
	status = "okay";
};

/* ── Low-frequency clock ─────────────────────────────────────────────── */
/* No 32.768 kHz crystal is fitted, and the FRTC8900's 32 kHz output is
 * deliberately not routed to the nRF — the RTC keeps wall-clock time on its
 * own DTCXO, so the SoC does not need an accurate external reference.
 *
 * The LFCLK source is therefore the internal RC oscillator, selected in
 * Kconfig.defconfig. It is NOT optional: Zephyr defaults nRF52 to XTAL and
 * hangs forever in lfclk_spinwait() at PRE_KERNEL_2 without one.
 *
 * Do not switch this to SYNTH ("derive it from the main clock") — that keeps
 * HFCLK running continuously at roughly a milliamp and cannot sleep. RC is a
 * separate low-power oscillator that survives sleep, which is what a battery
 * device needs. Cost is ±500 ppm instead of ±20-50 ppm, which BLE tolerates,
 * plus periodic recalibration against HFCLK. */

/* ── USB — MCUboot USB DFU WAIT mode ─────────────────────────────────── */
/* nRF52833 USBD uses dedicated D+/D- pins; VBUS detected via POWER
 * peripheral events — no GPIO VBUS pin needed.
 * cdc_acm_uart0 kept for MCUboot's USB DFU class enumeration. */
zephyr_udc0: &usbd {
	status = "okay";
	cdc_acm_uart0: cdc_acm_uart0 {
		compatible = "zephyr,cdc-acm-uart";
	};
};
